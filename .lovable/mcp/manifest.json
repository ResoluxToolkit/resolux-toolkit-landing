{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "resolux-toolkit-landing",
      "version": "0.1.0",
      "title": "Resolux Toolkit Landing"
    },
    "tools": [
      {
        "name": "get_product_overview",
        "title": "Get product overview",
        "description": "Returns a concise public overview of ResoluxToolkit and its operating principles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "enum": [
                "pt",
                "en"
              ],
              "default": "pt",
              "description": "Response language."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_project_status",
        "title": "Get project status",
        "description": "Returns the current public development status of ResoluxToolkit without roadmap promises.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "enum": [
                "pt",
                "en"
              ],
              "default": "pt",
              "description": "Response language."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
